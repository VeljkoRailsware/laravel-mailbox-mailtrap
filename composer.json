{
    "name": "veljkorailsware/laravel-mailbox-mailtrap",
    "description": "Mailtrap Inbound Email driver for beyondcode/laravel-mailbox",
    "keywords": ["laravel", "mailbox", "mailtrap", "inbound", "email", "webhook"],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.2",
        "beyondcode/laravel-mailbox": "^6.0",
        "railsware/mailtrap-php": "^3.15",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": { "VeljkoRailsware\\LaravelMailboxMailtrap\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "VeljkoRailsware\\LaravelMailboxMailtrap\\Tests\\": "tests/" }
    },
    "extra": {
        "laravel": {
            "providers": ["VeljkoRailsware\\LaravelMailboxMailtrap\\MailtrapMailboxServiceProvider"]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
